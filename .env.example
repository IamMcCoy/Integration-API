# 로컬 테스트용 환경변수 예시.
#
#   cp .env.example .env   후 값을 채운다.
#
# .env 는 커밋하지 않는다. 운영(K8s)에서는 이 파일을 쓰지 않고 환경변수를 직접 주입한다.
# Application 이 기동 시 load_dotenv() 로 읽는다 — 파일이 없으면 조용히 넘어간다.
#
# IA_ 접두사가 붙은 값은 conf/ia-conf.xml 의 같은 이름 설정을 덮어쓴다.
# 즉 XML 을 고치지 않고도 테스트 설정을 바꿀 수 있다.
# 접두사가 없는 OPENAI_API_KEY 는 OpenAI SDK 가 직접 읽는 규약 이름이다.

# ---------------------------------------------------------------------------
# 필수
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# 모델 — 선별은 청크마다 부르므로 싸고 빠른 것, 추출은 정확한 것
# 실제로 쓸 수 있는 모델명으로 맞춘다.
# ---------------------------------------------------------------------------
IA_OPENAI_FILTER_MODEL=gpt-4o-mini
IA_OPENAI_EXTRACT_MODEL=gpt-4o-mini

# 사내 vLLM 등 OpenAI 호환 서버를 쓸 때만. 비우면 공식 엔드포인트.
IA_OPENAI_BASE_URL=

# 같은 입력에 같은 결과가 나오도록 고정한다. 추론 모델은 이 인자를 받지 않으니 그때는 비운다.
IA_OPENAI_TEMPERATURE=0

# 동시에 날리는 OpenAI 요청 수. 레이트 리밋에 걸리면 줄인다.
IA_OPENAI_MAX_CONCURRENCY=8

# ---------------------------------------------------------------------------
# 신뢰도 임계값 — 실제 문서를 돌려 보며 조정한다
# ---------------------------------------------------------------------------
# 이 점수 이상이면 사람 확인 없이 api_definition / api_schema 로 적재
IA_SCORE_AUTO_THRESHOLD=90
# 이 점수 미만이면 반려. 사이 구간은 승인 대기
IA_SCORE_REVIEW_THRESHOLD=70

# ---------------------------------------------------------------------------
# Redis
#
# k3d 클러스터 안의 Redis 에 붙는다면 NodePort 를 거쳐야 한다.
#   IA_REDIS_HOST=<노드 IP>   IA_REDIS_PORT=30379
# ---------------------------------------------------------------------------
IA_REDIS_HOST=localhost
IA_REDIS_PORT=6379
IA_REDIS_DB=0
IA_REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# 워커 / 업로드
# ---------------------------------------------------------------------------
# 한 프로세스에서 돌릴 워커 수. 1 이면 문서 하나가 뒤를 전부 막는다.
IA_WORKER_COUNT=4

# 테스트할 때는 로컬 경로로 바꾼다. 기본값(/eyeCloudAI/app/staging)은 컨테이너 경로다.
IA_UPLOAD_STAGING_DIR=/tmp/ia-staging
IA_UPLOAD_MAX_BYTES=20971520

# 완료된 태스크를 Redis 에 유지하는 시간(초)
IA_TASK_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# MariaDB
#
# DB 접속 정보만은 여기가 아니라 conf/db.properties 에 있다.
# DBPool 이 그 파일을 직접 읽고 자격증명을 AES256 으로 복호화한다.
#
#   [database]
#   url=127.0.0.1:3306/integration_api
#   username=<AES256 암호문>
#   password=<AES256 암호문>
#   pool_size=5
#   pool_recycle=500
#
# 암호문은 이렇게 만든다 (출력 두 줄을 각각 username / password 에):
#   PYTHONPATH=. python -m src.utils.AES256 <계정> <비밀번호>
#
# 스키마는 sql/schema.sql 을 직접 적용한다.
#   mysql -h 127.0.0.1 -u root -p integration_api < sql/schema.sql
# ---------------------------------------------------------------------------
